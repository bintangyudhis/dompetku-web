# Contoh environment variable DompetKu (JANGAN isi secret asli di sini).
# Salin ke .env lalu isi nilainya. File .env tidak di-commit ke Git.

# Database: Supabase Postgres via connection pooler.
# DATABASE_URL  = pooler transaksi (port 6543) — dipakai aplikasi saat runtime.
# DIRECT_URL    = pooler session  (port 5432) — dipakai Prisma untuk migrasi.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# NextAuth — generate string acak, mis. dengan: openssl rand -base64 32
# Wajib di-set juga di Vercel (Project Settings → Environment Variables).
NEXTAUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
