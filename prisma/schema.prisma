generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  password     String
  createdAt    DateTime        @default(now())
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  shortcuts    QuickShortcut[]
  recurring    RecurringTemplate[]
}

model Category {
  id           String          @id @default(cuid())
  name         String
  icon         String          @default("💰")
  type         String // INCOME | EXPENSE
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  shortcuts    QuickShortcut[]
  recurring    RecurringTemplate[]

  @@unique([userId, name])
}

/// Preset pengeluaran 1-klik, mis. "Parkir 2k" — bisa ditambah/diubah pengguna.
model QuickShortcut {
  id         String    @id @default(cuid())
  label      String
  amount     Int // dalam rupiah, tanpa desimal
  icon       String    @default("⚡")
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, label])
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Int // dalam rupiah, tanpa desimal
  note       String?
  date       DateTime @default(now())
  type       String // INCOME | EXPENSE
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id         String   @id @default(cuid())
  amount     Int // batas per bulan, dalam rupiah
  month      Int // 1-12
  year       Int
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

/// Pemasukan berulang tiap bulan (mis. gaji) — diterbitkan jadi transaksi
/// lewat tombol "Terapkan bulan ini".
model RecurringTemplate {
  id          String   @id @default(cuid())
  label       String // mis. "Gaji bulanan"
  amount      Int // dalam rupiah, tanpa desimal
  note        String?
  dayOfMonth  Int      @default(1) // tanggal terbit tiap bulan (1-28)
  active      Boolean  @default(true)
  lastApplied String? // "YYYY-MM" terakhir diterbitkan
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}
