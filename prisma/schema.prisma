generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
}

model Category {
  id           String        @id @default(cuid())
  name         String
  icon         String        @default("💰")
  type         String // INCOME | EXPENSE
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Int // dalam rupiah, tanpa desimal
  note       String?
  date       DateTime @default(now())
  type       String // INCOME | EXPENSE
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id         String   @id @default(cuid())
  amount     Int // batas per bulan, dalam rupiah
  month      Int // 1-12
  year       Int
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}
